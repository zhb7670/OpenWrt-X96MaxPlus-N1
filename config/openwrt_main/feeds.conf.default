#==============================================================================
# OpenWrt-X96MaxPlus-N1 - feeds.conf.default
#
# 用途：源码编译路线的 feed 源清单
# 被 .github/workflows/build-openwrt-system-image.yml 的
#       "Load custom feeds" 步骤覆盖到 openwrt/feeds.conf.default
#
# ⚠️ 重要：此文件会【整体覆盖】上游默认 feeds.conf.default
#          -> 官方 feed 必须全部写在这里，否则官方包全部装不上
#
# 目标：覆盖原固件全部菜单项（只能多不能少）
#==============================================================================

# ---- 官方 feeds (OpenWrt main) ----
src-git packages  https://github.com/openwrt/packages.git
src-git luci      https://github.com/openwrt/luci.git
src-git routing   https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
# 以下为 OpenWrt main 默认附带但常被遗漏的 feeds
src-git video     https://github.com/openwrt/video.git

# ---- 三方 feeds ----
# small-package：覆盖约 45 个目标插件
#   (passwall/passwall2/openclash/ssr-plus/mosdns/adguardhome/dockerman/
#    alist/qbittorrent/aria2/gost/udp2raw/vlmcsd/frp/verysync/...)
src-git small     https://github.com/kenzok8/small-package.git

# luci-app-amlogic：晶晨宝盒（已由 diy-part2.sh 单独 clone，此处保留兼容）
# src-git amlogic  https://github.com/ophub/luci-app-amlogic.git
