#======================================================================================
#
# OpenWrt-X96MaxPlus-N1  -  Image Builder custom package list
#
# Format: CONFIG_PACKAGE_<name>=y     -> package WILL be installed
#         (anything absent or `is not set` -> not installed)
#
# PHASE 1 = minimal bootable firmware.
#   Goal: OpenWrt + LuCI + SSH + network + USB + storage + basic tools.
#   Large plugins (OpenClash / PassWall / Docker / AdGuardHome / Samba / ...)
#   are intentionally NOT here yet - see roadmap in README.
#
# NOTE: core packages (luci, luci-base, luci-app-amlogic, kmod-brcmfmac, wpad...)
#       are already force-listed in config/imagebuilder/imagebuilder.sh.
#       This file adds Phase-1 extras only.
#
#======================================================================================

# ---- SSH / terminal ----
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y

# ---- LuCI essentials (HTTPS / ttyd / file manager / backup / upgrade) ----
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-argon=y

# ---- network diagnostics / system monitor ----
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y

# ---- disk / storage management ----
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# ---- filesystem tools (USB / external disks) ----
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

# ---- USB support ----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-acm=y

# ---- Amlogic SoC support (X96 Max+ S905X3 / N1 S905D) ----
CONFIG_PACKAGE_kmod-meson-gxbb=y
CONFIG_PACKAGE_kmod-mmc-meson-gx=y
CONFIG_PACKAGE_kmod-amlogic-ir=y

# ---- WiFi drivers: RTL8822CS (X96Max+) & BCM43455 (N1) ----
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-rtw88-8822cs=y
CONFIG_PACKAGE_kmod-rtw88=y
CONFIG_PACKAGE_kmod-rtl8822cu=y

# ---- Bluetooth ----
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-btusb=y
CONFIG_PACKAGE_kmod-brcmutil-bt=y
CONFIG_PACKAGE_kmod-btbcm=y
CONFIG_PACKAGE_luci-app-bluetooth=y

# ---- basic shell utilities ----
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_bind-dig=y

# ---- zoneinfo (CN) ----
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y
